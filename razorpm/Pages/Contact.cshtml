@page "/Contact"
@model razorpm.Pages.ContactModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Связь";
}

<div class="form-page">
    <div class="form-actions-top">
        <a class="btn btn-soft" asp-page="/Profile">Профиль</a>
    </div>

    <section class="form-card">
        <div class="form-card-head">
            <h1>Связь с администратором</h1>
        </div>

        <form method="post" class="clean-form">
            <div class="form-group">
                <label>Тема</label>
                <input asp-for="Subject"
                       required
                       minlength="3"
                       maxlength="120" />
            </div>

            <div class="form-group">
                <label>Сообщение</label>
                <textarea asp-for="MessageText"
                          rows="5"
                          required
                          minlength="10"
                          maxlength="2000"></textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="form-error">@Model.Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Success))
            {
                <div class="form-success">@Model.Success</div>
            }

            <div class="form-actions">
                <button class="btn" type="submit">Отправить</button>
                <a class="btn btn-soft" asp-page="/Profile">Отмена</a>
            </div>
        </form>
    </section>
</div>