@page "/ForgotPassword"
@model razorpm.Pages.ForgotPasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Восстановление пароля";
}

<div class="simple-auth-page">
    <section class="simple-auth-card">
        <h1>Восстановление пароля</h1>

        <form method="post" class="simple-auth-form">
            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email"
                       type="email"
                       required
                       maxlength="100" />
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="form-error">@Model.Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="form-success">@Model.Message</div>
            }

            <div class="simple-auth-actions">
                <button class="btn" type="submit">Отправить</button>
                <a class="btn btn-soft" asp-page="/Login">Назад</a>
            </div>
        </form>
    </section>
</div>