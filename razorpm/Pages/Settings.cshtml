@page
@model razorpm.Pages.SettingsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Настройки";
}

<div class="form-page">
    <div class="form-actions-top">
        <a class="btn btn-soft" asp-page="/Profile">Профиль</a>
        <a class="btn btn-soft" asp-page="/ChangePassword">Сменить пароль</a>
    </div>

    <section class="form-card">
        <div class="form-card-head">
            <h1>Настройки</h1>
        </div>

        <form method="post" class="clean-form">
            <div class="form-grid form-grid-one">
                <div class="form-group">
                    <label>Имя</label>
                    <input asp-for="Name"
                           required
                           minlength="2"
                           maxlength="60" />
                </div>

                <div class="form-group">
                    <label>Логин</label>
                    <input asp-for="Login"
                           required
                           minlength="3"
                           maxlength="30"
                           pattern="[A-Za-zА-Яа-яЁё0-9_.-]+"
                           title="Логин может содержать только буквы, цифры, точку, дефис и подчёркивание" />
                </div>

                <div class="form-group">
                    <label>Тема</label>
                    <select asp-for="Theme" required>
                        <option value="light">Светлая</option>
                        <option value="dark">Темная</option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="form-error">@Model.Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Success))
            {
                <div class="form-success">@Model.Success</div>
            }

            <div class="form-actions">
                <button class="btn" type="submit">Сохранить</button>
                <a class="btn btn-soft" asp-page="/Profile">Отмена</a>
            </div>
        </form>
    </section>
</div>