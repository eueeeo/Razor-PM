@page
@model razorpm.Pages.ChangePasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Смена пароля";
}

<div class="form-page">
    <div class="form-actions-top">
        <a class="btn btn-soft" asp-page="/Settings">Настройки</a>
        <a class="btn btn-soft" asp-page="/Profile">Профиль</a>
    </div>

    <section class="form-card">
        <div class="form-card-head">
            <h1>Смена пароля</h1>
        </div>

        <form method="post" class="clean-form">
            <div class="form-grid form-grid-one">
                <div class="form-group">
                    <label>Текущий пароль</label>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                </div>

                <div class="form-group">
                    <label>Новый пароль</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                </div>

                <div class="form-group">
                    <label>Повтор нового пароля</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="form-error">@Model.Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Success))
            {
                <div class="form-success">@Model.Success</div>
            }

            <div class="form-actions">
                <button class="btn" type="submit">Сохранить</button>
                <a class="btn btn-soft" asp-page="/Settings">Отмена</a>
            </div>
        </form>
    </section>
</div>