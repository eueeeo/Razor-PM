@page "/ProjectCreate"
@model razorpm.Pages.ProjectCreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Создание проекта";
}

<div class="form-page">
    <div class="form-actions-top">
        <a class="btn btn-soft" asp-page="/Projects">К проектам</a>
    </div>

    <section class="form-card">
        <div class="form-card-head">
            <h1>Новый проект</h1>
        </div>

        <form method="post" class="clean-form">
            <div class="form-group">
                <label>Название</label>
                <input asp-for="Name"
                       required
                       minlength="3"
                       maxlength="100" />
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="form-error">@Model.Error</div>
            }

            <div class="form-actions">
                <button class="btn" type="submit">Создать</button>
                <a class="btn btn-soft" asp-page="/Projects">Отмена</a>
            </div>
        </form>
    </section>
</div>