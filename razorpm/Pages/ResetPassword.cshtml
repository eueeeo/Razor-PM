@page "/ResetPassword"
@model razorpm.Pages.ResetPasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Новый пароль";
}

<div class="simple-auth-page">
    <section class="simple-auth-card">
        <h1>Новый пароль</h1>

        @if (!Model.IsTokenValid)
        {
            <div class="form-error">
                Ссылка восстановления недействительна или устарела.
            </div>

            <div class="simple-auth-actions">
                <a class="btn btn-soft" asp-page="/ForgotPassword">Запросить новую ссылку</a>
                <a class="btn btn-soft" asp-page="/Login">К входу</a>
            </div>
        }
        else
        {
            <form method="post" class="simple-auth-form">
                <input type="hidden" asp-for="Token" />

                <div class="form-group">
                    <label>Новый пароль</label>
                    <input asp-for="Password"
                           type="password"
                           autocomplete="new-password"
                           required
                           minlength="8"
                           maxlength="100"
                           pattern="(?=.*[a-zа-яё])(?=.*[A-ZА-ЯЁ])(?=.*\d)(?=.*[^A-Za-zА-Яа-яЁё0-9]).{8,100}"
                           title="Минимум 8 символов: большая буква, маленькая буква, цифра и спецсимвол" />
                </div>

                <div class="form-group">
                    <label>Повтор пароля</label>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           required
                           minlength="8"
                           maxlength="100" />
                </div>

                <div class="simple-auth-hint">
                    Пароль: минимум 8 символов, большая и маленькая буква, цифра и спецсимвол.
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="form-error">@Model.Error</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="form-success">@Model.Message</div>
                }

                <div class="simple-auth-actions">
                    <button class="btn" type="submit">Сохранить</button>
                    <a class="btn btn-soft" asp-page="/Login">К входу</a>
                </div>
            </form>
        }
    </section>
</div>