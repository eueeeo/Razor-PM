@page "/Login"
@model razorpm.Pages.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Вход";
}

<div class="simple-auth-page">
    <section class="simple-auth-card">
        <h1>Вход</h1>

        <form method="post" class="simple-auth-form">
            <div class="form-group">
                <label>Логин</label>
                <input asp-for="Login"
                       autocomplete="username"
                       required
                       minlength="3"
                       maxlength="30" />
            </div>

            <div class="form-group">
                <label>Пароль</label>
                <input asp-for="Password"
                       type="password"
                       autocomplete="current-password"
                       required
                       maxlength="100" />
            </div>

            <div class="text-muted" style="font-size:12px;">
                <a asp-page="/ForgotPassword">Забыли пароль?</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="form-error">@Model.Error</div>
            }

            <div class="simple-auth-actions">
                <button class="btn" type="submit">Войти</button>
                <a class="btn btn-soft" asp-page="/Register">Регистрация</a>
            </div>
        </form>
    </section>
</div>