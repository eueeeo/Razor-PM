@page
@model razorpm.Pages.UsersModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.IsDirectorMode ? "Сотрудники" : "Пользователи";

    var totalUsers = Model.Rows.Count;
    var activeUsers = Model.Rows.Count(u => u.IsActive);
    var disabledUsers = Model.Rows.Count(u => !u.IsActive);
    var admins = Model.Rows.Count(u => u.Role == "admin");
    var directors = Model.Rows.Count(u => u.Role == "director");
    var managers = Model.Rows.Count(u => u.Role == "manager");
    var executors = Model.Rows.Count(u => u.Role == "user");
}

<div class="users-page">
    <div class="users-summary">
        <div class="users-summary-item">
            <span>Всего</span>
            <strong>@totalUsers</strong>
        </div>

        <div class="users-summary-item">
            <span>Активные</span>
            <strong>@activeUsers</strong>
        </div>

        @if (!Model.IsDirectorMode)
        {
            <div class="users-summary-item muted">
                <span>Отключенные</span>
                <strong>@disabledUsers</strong>
            </div>

            <div class="users-summary-item">
                <span>Админы</span>
                <strong>@admins</strong>
            </div>

            <div class="users-summary-item">
                <span>Руководители</span>
                <strong>@directors</strong>
            </div>
        }

        <div class="users-summary-item">
            <span>Ответственные</span>
            <strong>@managers</strong>
        </div>

        <div class="users-summary-item">
            <span>Исполнители</span>
            <strong>@executors</strong>
        </div>
    </div>

    <form method="get" class="users-filters">
        <input name="q"
               value="@Model.q"
               maxlength="100"
               placeholder="Поиск по имени, логину или email" />

        <select name="role">
            <option value="">Все роли</option>

            @if (!Model.IsDirectorMode)
            {
                <option value="admin" selected="@(Model.role == "admin")">Администратор</option>
                <option value="director" selected="@(Model.role == "director")">Руководитель</option>
            }

            <option value="manager" selected="@(Model.role == "manager")">Ответственный</option>
            <option value="user" selected="@(Model.role == "user")">Исполнитель</option>
        </select>

        <button class="btn btn-soft" type="submit">Применить</button>
        <a class="btn btn-soft" asp-page="/Users">Сбросить</a>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.UserError))
    {
        <div class="form-error">
            @Model.UserError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.UserMessage))
    {
        <div class="form-success">
            @Model.UserMessage
        </div>
    }

    <div class="users-card">
        @if (Model.Rows.Count == 0)
        {
            <div class="users-empty">
                Пользователи не найдены
            </div>
        }
        else
        {
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Пользователь</th>
                        <th>Логин</th>
                        <th>Email</th>
                        <th>Роль</th>
                        <th>Статус</th>
                        <th>Проекты</th>
                        <th>Участие</th>
                        <th>Задачи</th>
                        <th class="users-actions-col">Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model.Rows)
                    {
                        <tr class="@(user.IsActive ? "" : "user-row-disabled")">
                            <td>
                                <div class="user-cell">
                                    <div class="user-mini-avatar">
                                        @(string.IsNullOrWhiteSpace(user.Name) ? "U" : user.Name.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <div class="user-name">
                                            @user.Name

                                            @if (user.IsCurrentUser)
                                            {
                                                <span class="badge user-current-badge">Вы</span>
                                            }
                                        </div>

                                        <div class="user-small-muted">
                                            @user.RoleTitle
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>@user.Login</td>
                            <td>@user.Email</td>

                            <td>
                                <span class="badge">
                                    @user.RoleTitle
                                </span>
                            </td>

                            <td>
                                <span class="badge @(user.IsActive ? "status-active" : "status-done")">
                                    @(user.IsActive ? "Активен" : "Отключен")
                                </span>
                            </td>

                            <td>@user.OwnerProjectsCount</td>
                            <td>@user.MemberProjectsCount</td>
                            <td>@user.AssignedTasksCount</td>

                            <td>
                                <div class="users-actions">
                                    @if (Model.CanChangeRole(user))
                                    {
                                        <form method="post"
                                              asp-page-handler="ChangeRole"
                                              asp-route-id="@user.Id">

                                            <input type="hidden" name="q" value="@Model.q" />
                                            <input type="hidden" name="role" value="@Model.role" />

                                            <select name="newRole" class="role-select-small">
                                                @if (!Model.IsDirectorMode)
                                                {
                                                    <option value="admin" selected="@(user.Role == "admin")">Администратор</option>
                                                    <option value="director" selected="@(user.Role == "director")">Руководитель</option>
                                                }

                                                <option value="manager" selected="@(user.Role == "manager")">Ответственный</option>
                                                <option value="user" selected="@(user.Role == "user")">Исполнитель</option>
                                            </select>

                                            <button class="btn btn-soft btn-small"
                                                    type="submit"
                                                    onclick="return confirm('Изменить роль пользователя?');">
                                                Сохранить
                                            </button>
                                        </form>
                                    }

                                    @if (Model.CanToggleActive(user))
                                    {
                                        <form method="post"
                                              asp-page-handler="ToggleActive"
                                              asp-route-id="@user.Id">

                                            <input type="hidden" name="q" value="@Model.q" />
                                            <input type="hidden" name="role" value="@Model.role" />

                                            <button class="btn btn-soft btn-small"
                                                    type="submit"
                                                    onclick="return confirm('@(user.IsActive ? "Отключить пользователя?" : "Включить пользователя?")');">
                                                @(user.IsActive ? "Отключить" : "Включить")
                                            </button>
                                        </form>
                                    }

                                    @if (!Model.CanChangeRole(user) && !Model.CanToggleActive(user))
                                    {
                                        <span class="user-action-muted">
                                            @(user.IsCurrentUser ? "Текущий аккаунт" : "Нет действий")
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>